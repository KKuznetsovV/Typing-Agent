# ─── Auth Service ────────────────────────────────────────────────────────────
JWT_SECRET=your-random-jwt-secret
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Public URL of the webhooks service (use ngrok or similar for local dev)
GITHUB_WEBHOOK_URL=https://your-ngrok-url/api/webhooks/github
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# ─── Shared inter-service secret (all services must share the same value) ────
SERVICE_AUTH_SECRET=your-random-service-auth-secret

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# ─── SQS / LocalStack (defaults work for local docker-compose dev) ────────────
SQS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_TECH_LEAD=tech-lead-queue
SQS_QUEUE_BACKEND_DEV=backend-dev-queue
SQS_QUEUE_FRONTEND_DEV=frontend-dev-queue
SQS_QUEUE_DEVOPS=devops-queue
SQS_QUEUE_CODE_REVIEWER=code-reviewer-queue
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── Optional: per-agent GitHub tokens ───────────────────────────────────────
# Leave empty to use the user's OAuth token for all commits/PRs.
# Set these to GitHub PATs for a dedicated bot account if you want commits
# attributed to the agent bot rather than the authenticated user.
GITHUB_AGENT_BACKEND_DEV_TOKEN=
GITHUB_AGENT_FRONTEND_DEV_TOKEN=
GITHUB_AGENT_DEVOPS_TOKEN=
GITHUB_AGENT_CODE_REVIEWER_TOKEN=
