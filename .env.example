# Copy this file to .env and fill in your values before running docker compose

# GitHub OAuth App credentials
# Create one at https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Callback URL registered in your GitHub OAuth App
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Long random secret used to sign JWTs — change this!
JWT_SECRET=change-this-to-a-long-random-secret

# URL the browser uses to reach the frontend (used by backend for CORS & redirects)
FRONTEND_URL=http://localhost

# URL the browser uses to reach the backend (baked into the frontend bundle)
VITE_BACKEND_URL=http://localhost:3000
